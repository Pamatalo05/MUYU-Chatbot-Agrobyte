# Copia este archivo como .env y completa tu clave.
# Clave gratuita: https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=

# Modelos (nivel gratuito). El de respaldo se usa si el principal responde 429.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Orígenes que pueden llamar al backend (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173
