# Copia este archivo como .env (en la raíz). Lo leen `npm run dev` (web) y `npx netlify-cli dev`.
# En producción, pon estas variables en Netlify: Site configuration > Environment variables.
# La clave es gratis en https://aistudio.google.com/apikey — nunca la subas a git.
GEMINI_API_KEY=
# Opcional: modelo preferido. Si falla, se prueban gemini-flash-latest, gemini-3.8-flash y gemini-flash-lite-latest
GEMINI_MODEL=
